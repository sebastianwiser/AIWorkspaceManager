{
  "name": "skillmanager-os",
  "version": "0.4.0",
  "description": "A local-first desktop app and CLI for discovering, auditing, and safely importing AI skills.",
  "type": "module",
  "main": "./dist/desktop/main.js",
  "bin": {
    "skillmanager": "./bin/skillmanager.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:renderer",
    "build:core": "tsc --project tsconfig.build.json",
    "build:renderer": "vite build",
    "desktop": "npm run build && electron .",
    "start": "tsx ./src/main.ts",
    "scan": "tsx ./src/main.ts scan",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
